# Copy this file to .env and fill in real values.
#   cp ecommerce/.env.example ecommerce/.env
# .env is gitignored — never commit the real one.

# --- Django -----------------------------------------------------------------
# Generate a fresh one:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (only used when the Postgres block in settings.py is enabled) --
DATABASE_NAME=yourdb
DATABASE_USER=youruser
DATABASE_PASS=yourpassword

# --- AWS / S3 (only used when USE_S3 = True) --------------------------------
AWS_SECRET_ID=your-access-key-id
AWS_SECRET_KEY=your-secret-access-key

# --- Email ------------------------------------------------------------------
# Gmail requires an *app password* (not your account password):
#   https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
# Gmail rejects any From address other than the authenticated account
DEFAULT_FROM_EMAIL=you@example.com
# Where 'new order' notifications are sent
STORE_ORDER_EMAIL=you@example.com

# Dev convenience: print emails to the console instead of really sending them,
# so account-activation links show up in `runserver` output.
EMAIL_CONSOLE_IN_DEBUG=True
